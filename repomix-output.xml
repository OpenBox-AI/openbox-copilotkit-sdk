      agentDid: identity.agentDid,
      agentPrivateKey: identity.agentPrivateKey,
      apiKey: "obx_test_approval_key",
      apiUrl: "https://api.openbox.ai"
    });

    await client.pollApproval({
      activityId: "act-789",
      runId: "run-456",
      workflowId: "wf-123"
    });

    expect(observedRequest).toBeDefined();
    expectValidAgentIdentityHeaders({
      body: observedBody,
      method: "POST",
      pathname: "/api/v1/governance/approval",
      publicKey: identity.publicKey,
      request: observedRequest!
    });
  });

  it.each([
    "2020-01-01T00:00:00Z",
    "2020-01-01T00:00:00+00:00",
    "2020-01-01 00:00:00"
  ])("marks expired approvals across supported timestamp formats", async timestamp => {
    server.use(
      http.post("https://api.openbox.ai/api/v1/governance/approval", () =>
        HttpResponse.json({
          approval_expiration_time: timestamp,
          verdict: "require_approval"
        })
      )
