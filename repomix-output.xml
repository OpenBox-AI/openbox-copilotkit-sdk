      runId: "run-456",
      workflowId: "wf-123"
    });

    expect(response).toMatchObject({
      approval_expiration_time: timestamp,
      expired: true,
      verdict: "require_approval"
    });
  });

  it("leaves null expiration values unexpired", async () => {
    server.use(
      http.post("https://api.openbox.ai/api/v1/governance/approval", () =>
