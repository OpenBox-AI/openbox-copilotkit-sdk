AGENT_URL=http://localhost:8123
OPENAI_API_KEY=

# --- OpenBox governance and telemetry (optional) ---
# Shared OpenBox Core endpoint. The SDK-specific URL variables below may
# override it when the two boundaries use different environments.
OPENBOX_URL=https://core.openbox.ai

# CopilotKit parent/runtime boundary
OPENBOX_COPILOTKIT_API_KEY=
OPENBOX_COPILOTKIT_AGENT_DID=
OPENBOX_COPILOTKIT_AGENT_PRIVATE_KEY=
# OPENBOX_COPILOTKIT_API_URL=https://core.openbox.ai

# LangGraph Python/backend boundary
OPENBOX_LANGGRAPH_API_KEY=
OPENBOX_LANGGRAPH_AGENT_DID=
OPENBOX_LANGGRAPH_AGENT_PRIVATE_KEY=
# OPENBOX_LANGGRAPH_API_URL=https://core.openbox.ai
# OPENBOX_LANGGRAPH_VALIDATE=true

# A shared single-agent identity can be used instead of the SDK-specific
# credentials above. Distinct identities are recommended for clearer traces.
# OPENBOX_API_KEY=
# OPENBOX_AGENT_DID=
# OPENBOX_AGENT_PRIVATE_KEY=
# OPENBOX_DEBUG=1

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
